#!/usr/bin/env bash
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
HERE="$(cd -P "$(dirname "$src")" && pwd)"
KEYS="$HERE/keys.conf"
port=""
watcher=""
loginwatch=""
cleanup() {
  [[ -n "$watcher" ]] && kill "$watcher" 2>/dev/null
  [[ -n "$loginwatch" ]] && kill "$loginwatch" 2>/dev/null
  [[ -n "$port" ]] && rmdir "$HERE/.ports/$port" 2>/dev/null
  return 0
}
trap cleanup EXIT
ROUTER="http://127.0.0.1:4848"

prism_cmd() {
  if [[ "$(command -v prism 2>/dev/null)" -ef "$HERE/prism" ]]; then
    echo prism
  else
    echo "${HERE/#$HOME/\~}/prism"
  fi
}

network_mode() {
  local file="$HERE/.network" code=0
  if [[ ! -s "$file" ]]; then
    docker info >/dev/null 2>&1 || { echo bridge; return; }
    docker run --rm alpine:3 wget -q -T 8 -O /dev/null https://deb.debian.org >/dev/null 2>&1 || code=$?
    case "$code" in
      0) echo bridge > "$file" ;;
      1) [[ "$(uname -s)" == Linux ]] && ! grep -qi microsoft /proc/version 2>/dev/null && echo host > "$file" || echo bridge > "$file" ;;
      *) echo bridge; return ;;
    esac
  fi
  cat "$file"
}

compose() {
  local extra=()
  if [[ ! -s "$HERE/.router-token" ]]; then
    local tmp="$HERE/.router-token.$$"
    (umask 077; od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$tmp")
    [[ -s "$HERE/.router-token" ]] || mv -f "$tmp" "$HERE/.router-token"
    rm -f "$tmp"
  fi
  chmod 600 "$HERE/.router-token"
  export PRISM_ROUTER_TOKEN="$(cat "$HERE/.router-token")"
  [[ -d "$HERE/custom-providers.json" ]] && rmdir "$HERE/custom-providers.json" 2>/dev/null
  [[ -e "$HERE/custom-providers.json" ]] || { echo "[]" > "$HERE/custom-providers.json"; chmod 600 "$HERE/custom-providers.json"; }
  [[ -d "$HERE/keys.conf" ]] && rmdir "$HERE/keys.conf" 2>/dev/null
  [[ -e "$HERE/keys.conf" ]] || { touch "$HERE/keys.conf"; chmod 600 "$HERE/keys.conf"; }
  [[ -d "$HERE/subscriptions.json" ]] && rmdir "$HERE/subscriptions.json" 2>/dev/null
  [[ -e "$HERE/subscriptions.json" ]] || { echo '{}' > "$HERE/subscriptions.json"; chmod 600 "$HERE/subscriptions.json"; }
  [[ "$(network_mode)" == host ]] && extra=(-f "$HERE/docker-compose.host.yml")
  docker compose --project-directory "$HERE" -f "$HERE/docker-compose.yml" ${extra[@]+"${extra[@]}"} "$@"
}

usage() {
  cat <<'EOF'
Prism: free AI that codes, beautifully. Runs inside Docker.

  prism                 code in the current folder
  prism <folder>        code in that folder
  prism continue        pick up the last chat in the current folder
  prism web [folder]    the same, in your browser at http://127.0.0.1:4849
  prism tree            the project's files, changes and links (--html for a page)
  prism fix             computer help: looks at THIS computer, asks before every change
  prism setup           add free keys for more models (optional, never a card)
  prism keys            list your keys · keys add: a model you pay for · keys remove <id>
  prism status          see which free AI models are ready
  prism logs            watch which model answers each message
  prism stop            stop the background AI router
  prism install         add the prism command to your terminal
  prism update          get the newest version of prism

Except for "prism fix", Prism can only see the folder you give it.
EOF
}

pick_folder() {
  local folder
  folder="$(cd "${1:-$PWD}" 2>/dev/null && pwd)" || { echo "Folder not found: ${1:-$PWD}" >&2; exit 1; }
  if [[ "$folder" == "/" || "$folder" == "$HOME" ]]; then
    echo "Prism won't start in your home folder or /. Use cd to go into a project folder first." >&2
    exit 1
  fi
  echo "$folder"
}

# images_current: the images exist and no source they are built from changed since the last
# successful build. A cached build still costs ~10s of BuildKit context work, so skip it.
images_current() {
  [[ -f "$HERE/.built" ]] && [[ "$(cat "$HERE/.built")" == "$(build_id)" ]] &&
    docker image inspect prism-agent prism-router >/dev/null 2>&1 &&
    [[ -z "$(find "$HERE/cli" "$HERE/router" "$HERE/web" "$HERE/agent" "$HERE"/docker-compose*.yml -newer "$HERE/.built" -print -quit 2>/dev/null)" ]]
}

# build_id is the checked-out commit, so a git checkout of older files (older mtimes) still rebuilds.
build_id() { git -C "$HERE" rev-parse HEAD 2>/dev/null || echo none; }
mark_built() { build_id > "$HERE/.built"; }

# build_images builds both images. With host networking, compose's bake builder refuses
# --network host without an extra privilege flag it has no way to pass, so use docker build.
build_images() {
  if [[ "$(network_mode)" == host ]]; then
    docker build -q --network host -t prism-router "$HERE/router" >/dev/null &&
      docker build -q --network host -t prism-agent -f "$HERE/agent/Dockerfile" "$HERE" >/dev/null
  else
    compose build --quiet router agent
  fi
}

router_ready() { curl -fsS -m 2 "$ROUTER/health" >/dev/null 2>&1; }

start_router() {
  local output
  if images_current && router_ready; then
    return
  fi
  if images_current; then
    :
  elif output="$(build_images 2>&1)"; then
    mark_built
  else
    if docker image inspect prism-agent prism-router >/dev/null 2>&1; then
      echo "Couldn't check for updates (Docker Hub may be down). Starting the version you already have." >&2
    else
      echo "$output" >&2
      if echo "$output" | grep -q 'docker-credential-desktop\.exe' && echo "$output" | grep -q 'exec format error'; then
        echo "Docker needs to start a Windows program, and this Linux can't run Windows programs right now." >&2
        echo "To fix it for good, run this, then reopen this terminal and try again:" >&2
        echo "  sudo mkdir -p /usr/lib/binfmt.d && echo ':WSLInterop:M::MZ::/init:PF' | sudo tee /usr/lib/binfmt.d/WSLInterop.conf" >&2
        echo "  Then in Windows PowerShell: wsl --shutdown" >&2
      elif echo "$output" | grep -q 'error getting credentials'; then
        echo "Docker couldn't read its login settings. Move them aside and try again:" >&2
        echo "  mv ~/.docker/config.json ~/.docker/config.json.bak" >&2
      elif echo "$output" | grep -qiE "requires buildx|buildx (plugin )?(is )?(not found|not installed|missing)|'buildx' is not a docker command"; then
        echo "Docker is missing its build helper (buildx). Install it, then try again:" >&2
        echo "  Arch, CachyOS, Manjaro: sudo pacman -S docker-buildx" >&2
        echo "  Ubuntu, Mint, Debian:   sudo apt install docker-buildx" >&2
      elif echo "$output" | grep -q 'toomanyrequests'; then
        echo "Docker Hub is limiting downloads right now. Wait a few minutes and try again." >&2
      else
        echo "Docker couldn't download what Prism needs. Check your internet and try again in a minute." >&2
      fi
      exit 1
    fi
  fi
  compose up -d router >/dev/null 2>&1
  for _ in $(seq 1 60); do
    if command -v curl >/dev/null 2>&1; then router_ready && return
    else compose exec -T router wget -qO- "$ROUTER/health" >/dev/null 2>&1 && return
    fi
    sleep 0.25
  done
  echo "The AI router did not start. Run: $(prism_cmd) logs" >&2
  exit 1
}

free_port() {
  local port
  mkdir -p "$HERE/.ports"
  for port in $(seq 4849 4899); do
    (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && continue
    if mkdir "$HERE/.ports/$port" 2>/dev/null; then
      echo "$port"
      return
    fi
    find "$HERE/.ports/$port" -maxdepth 0 -mmin +720 -exec rmdir {} \; 2>/dev/null || true
  done
  echo "No free port between 4849 and 4899. Close another prism and try again." >&2
  exit 1
}

open_browser() {
  if grep -qi microsoft /proc/version 2>/dev/null; then
    if command -v wslview >/dev/null 2>&1; then wslview "$1"
    else (cd /mnt/c && cmd.exe /c start "" "$1" >/dev/null 2>&1)
    fi
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1"
  elif command -v open >/dev/null 2>&1; then open "$1"
  else return 1
  fi
}

open_when_ready() {
  local url="http://127.0.0.1:$1" parent="$2" open=0 seen="" token
  command -v curl >/dev/null 2>&1 || return 0
  while sleep 2 && kill -0 "$parent" 2>/dev/null; do
    if curl -fs -m 1 -o /dev/null "$url/api/info"; then
      token="$(curl -fs -m 1 "$url/api/handoff-open" 2>/dev/null || true)"
      if [[ -n "$token" && "$token" != "$seen" ]]; then
        seen="$token"
        if open_browser "$url" >/dev/null 2>&1; then
          curl -fs -m 1 -H "Origin: $url" -X POST "$url/api/handoff-open" >/dev/null 2>&1 || true
        else
          curl -fs -m 1 -H "Origin: $url" -X POST "$url/api/handoff-open?failed=1" >/dev/null 2>&1 || true
        fi
      elif [[ -z "$token" && $open == 0 ]]; then
        open_browser "$url" >/dev/null 2>&1 || true
      fi
      open=1
    else
      open=0
    fi
  done
}

# Docker applies the window size to the container's terminal only after the container
# has started, so a program that reads it immediately sees 0x0 (and the resize signal can
# arrive before it listens). Hand it the real size as a fallback; the live size and
# resizes still win whenever the terminal reports one.
term_size_args() {
  [[ -t 0 ]] || return 0
  local cols lines
  read -r lines cols < <(stty size 2>/dev/null) || true
  if ! [[ "$cols" =~ ^[0-9]+$ && "$lines" =~ ^[0-9]+$ && "$cols" -gt 0 && "$lines" -gt 0 ]]; then
    cols="$(tput cols 2>/dev/null || true)"; lines="$(tput lines 2>/dev/null || true)"
  fi
  if [[ "$cols" =~ ^[0-9]+$ && "$lines" =~ ^[0-9]+$ && "$cols" -gt 0 && "$lines" -gt 0 ]]; then
    printf '%s\n' -e "COLUMNS=$cols" -e "LINES=$lines"
  fi
}

# watch_logins opens the browser when a subscription sign-in (/login chatgpt and so on)
# starts inside prism. The router holds the page until then.
watch_logins() {
  local parent="$1" last="" url
  command -v curl >/dev/null 2>&1 || return 0
  while sleep 2 && kill -0 "$parent" 2>/dev/null; do
    url="$(curl -fs -m 2 "$ROUTER/logins/pending" 2>/dev/null | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')"
    if [[ -n "$url" && "$url" != "$last" ]]; then
      last="$url"
      open_browser "$url" >/dev/null 2>&1 || true
    fi
  done
}

run_agent() {
  local folder="$1" publish=() listen size=(); shift
  while IFS= read -r line; do size+=("$line"); done < <(term_size_args)
  [[ -t 2 ]] && printf '\033[2m◆ starting prism…\033[0m\n' >&2
  start_router
  port="$(free_port)"
  if [[ "$(network_mode)" == host ]]; then
    listen="127.0.0.1:$port"
  else
    listen="0.0.0.0:$port"
    publish=(-p "127.0.0.1:$port:$port")
  fi
  open_when_ready "$port" $$ &
  watcher=$!
  watch_logins $$ &
  loginwatch=$!
  PRISM_WEB_LISTEN="$listen" PRISM_PUBLIC_PORT="$port" PRISM_PROJECT="${folder/#$HOME/\~}" PROJECT_DIR="$folder" HOST_UID="$(id -u)" HOST_GID="$(id -g)" compose run --rm -e PRISM_MEMORY_KEEP=1 ${size[@]+"${size[@]}"} ${publish[@]+"${publish[@]}"} agent "$@"
}

web() {
  local folder="$1" publish=() listen
  start_router
  port="$(free_port)"
  if [[ "$(network_mode)" == host ]]; then
    listen="127.0.0.1:$port"
  else
    listen="0.0.0.0:$port"
    publish=(-p "127.0.0.1:$port:$port")
  fi
  open_when_ready "$port" $$ &
  watcher=$!
  watch_logins $$ &
  loginwatch=$!
  PRISM_LISTEN="$listen" PRISM_PUBLIC_PORT="$port" PRISM_PROJECT="${folder/#$HOME/\~}" PROJECT_DIR="$folder" HOST_UID="$(id -u)" HOST_GID="$(id -g)" compose run --rm ${publish[@]+"${publish[@]}"} agent serve
}

fix() {
  local os arch bin
  os="$(uname -s | tr '[:upper:]' '[:lower:]')"
  case "$(uname -m)" in
    x86_64|amd64) arch=amd64 ;;
    arm64|aarch64) arch=arm64 ;;
    *) echo "Computer help isn't available for $(uname -m) yet." >&2; exit 1 ;;
  esac
  start_router
  bin="$HERE/.bin/prism-$os-$arch"
  mkdir -p "$HERE/.bin"
  local id
  id="$(docker create prism-agent)"
  docker cp "$id:/opt/prism/hosts/prism-$os-$arch" "$bin" >/dev/null 2>&1 || { docker rm -f "$id" >/dev/null; echo "Computer help isn't available for $os/$arch in this build." >&2; exit 1; }
  docker rm "$id" >/dev/null
  chmod +x "$bin"
  echo "Computer help mode: Prism runs on this computer (not in the Docker box)."
  echo "It can look around, and asks you before every command or file change."
  echo
  cd "$HOME"
  PRISM_ROUTER_TOKEN="$(cat "$HERE/.router-token")" PRISM_API="$ROUTER/v1" PRISM_PROJECT="this computer" "$bin" -system
}

install() {
  local bin="$HOME/.local/bin"
  mkdir -p "$bin"
  ln -sf "$HERE/prism" "$bin/prism"
  echo "Installed: $bin/prism"
  if [[ "${SHELL##*/}" == fish ]] || command -v fish >/dev/null 2>&1; then
    local fishrc="${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d/prism.fish"
    mkdir -p "${fishrc%/*}"
    [[ -f "$fishrc" ]] || echo 'fish_add_path -g "$HOME/.local/bin"' > "$fishrc"
  fi
  case ":$PATH:" in
    *":$bin:"*) echo "Run prism from any project folder." ;;
    *)
      if [[ "${SHELL##*/}" != fish ]]; then
        local rc="$HOME/.bashrc"
        [[ "${SHELL##*/}" == zsh ]] && rc="$HOME/.zshrc"
        [[ "$(uname -s)" == Darwin && "${SHELL##*/}" == bash ]] && rc="$HOME/.bash_profile"
        grep -qs '.local/bin' "$rc" || echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$rc"
      fi
      echo "Open a new terminal, then run prism from any project folder."
      ;;
  esac
}

ask_key() {
  local name="$1" label="$2" link="$3" current value
  current="$(grep -E "^$name=" "$KEYS" 2>/dev/null | cut -d= -f2- || true)"
  echo
  echo "$label"
  echo "  Get a free key: $link"
  if [[ -n "$current" ]]; then
    read -rsp "  Paste key (Enter keeps the saved one): " value
  else
    read -rsp "  Paste key (Enter to skip): " value
  fi
  echo
  value="${value:-$current}"
  { grep -vE "^$name=" "$KEYS" || true; echo "$name=$value"; } > "$KEYS.tmp"
  mv "$KEYS.tmp" "$KEYS"
  chmod 600 "$KEYS"
}

setup() {
  [[ -f "$KEYS" ]] || cp "$HERE/keys.example.conf" "$KEYS"
  chmod 600 "$KEYS"
  echo "Prism already works without keys. Each key below adds more free models, so you wait less."
  echo "None of them ask for a card. Press Enter to skip any of them."
  echo "Note: free AI services may keep what you send them. Don't send passwords or private data."
  ask_key NVIDIA_API_KEY "NVIDIA: fast Nemotron models, plus GLM-5.3 and GLM-5.3 Flash" "https://build.nvidia.com"
  ask_key GROQ_API_KEY "Groq: very fast GPT-OSS 120B" "https://console.groq.com/keys"
  ask_key GEMINI_API_KEY "Google: Gemini Flash" "https://aistudio.google.com/apikey"
  ask_key MISTRAL_API_KEY "Mistral: Codestral, made for code" "https://console.mistral.ai/api-keys"
  ask_key OPENROUTER_API_KEY "OpenRouter: free MiniMax and other free models (50 requests a day)" "https://openrouter.ai/keys"
  ask_key ZAI_API_KEY "Z.ai: GLM-4.7 Flash" "https://z.ai/manage-apikey/apikey-list"
  compose up -d --force-recreate router >/dev/null 2>&1
  echo
  echo "Saved. Run: $(prism_cmd) status"
  echo "Already pay for a model? Add it with: $(prism_cmd) keys add"
}

# Your own models (prism keys, keys add, keys remove). The list lives in
# custom-providers.json, one entry per line; the secret keys stay in keys.conf.
CUSTOM="$HERE/custom-providers.json"
FREE_KEYS="NVIDIA_API_KEY:NVIDIA GROQ_API_KEY:Groq GEMINI_API_KEY:Google MISTRAL_API_KEY:Mistral OPENROUTER_API_KEY:OpenRouter ZAI_API_KEY:Z.ai"

key_value() { grep -E "^$1=" "$KEYS" 2>/dev/null | cut -d= -f2- || true; }

mask_key() {
  if [[ -z "$1" ]]; then echo "(not set)"; elif (( ${#1} <= 8 )); then echo "****"; else echo "${1:0:3}...${1: -4}"; fi
}

set_key() {
  { grep -vE "^$1=" "$KEYS" 2>/dev/null || true; echo "$1=$2"; } > "$KEYS.tmp"
  mv "$KEYS.tmp" "$KEYS"
  chmod 600 "$KEYS"
}

custom_lines() { grep '^{' "$CUSTOM" 2>/dev/null | sed 's/,$//' || true; }

save_custom_lines() {
  local body
  body="$(sed '$!s/$/,/')"
  { echo "["; [[ -z "$body" ]] || echo "$body"; echo "]"; } > "$CUSTOM"
  chmod 600 "$CUSTOM"
}

entry_field() { sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" <<<"$2"; }

restart_router() { { build_images >/dev/null 2>&1 && mark_built && compose up -d --force-recreate router >/dev/null 2>&1; } || { echo "Couldn't restart the AI router. Run: $(prism_cmd) logs" >&2; exit 1; }; }

keys_list() {
  local pair key any=0 line id models var paid
  echo "Free providers (built in):"
  for pair in $FREE_KEYS; do
    key="$(key_value "${pair%%:*}")"
    [[ -n "$key" ]] || continue
    printf '  %-12s %s\n' "${pair#*:}" "$(mask_key "$key")"
    any=1
  done
  (( any )) || echo "  no keys yet. Prism works without them; add some with: $(prism_cmd) setup"
  echo
  echo "Your own models:"
  any=0
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    any=1
    id="$(entry_field id "$line")"
    var="$(entry_field keyVar "$line")"
    models="$(sed -n 's/.*"models":\[\([^]]*\)\].*/\1/p' <<<"$line" | tr -d '"' | tr ',' ' ')"
    paid="paid: only used when you pick it"
    [[ "$line" == *'"paid":false'* ]] && paid="free to you"
    printf '  %-14s %-26s %-14s (%s)\n' "$id" "$models" "$([[ -n "$var" ]] && mask_key "$(key_value "$var")" || echo "no key needed")" "$paid"
  done < <(custom_lines)
  (( any )) || echo "  none. Add one with: $(prism_cmd) keys add"
}

keys_add() {
  local choice id name url var def paid link key current models first test_url saved_url answer code body entry list m guess reserved
  echo "Add a model you pay for (or one on this computer)."
  echo "Paid ones only answer when you pick them by name. Free ones, like a model on this computer, can also answer for \"auto\"."
  echo
  echo "  1) OpenAI"
  echo "  2) Anthropic (Claude)"
  echo "  3) DeepSeek"
  echo "  4) OpenRouter (paid models)"
  echo "  5) Ollama on this computer (no key)"
  echo "  6) other (any OpenAI-compatible URL)"
  read -rp "Which one? [1-6] " choice || exit 1
  paid=true; var=""; def=""; link=""
  case "$choice" in
    1) id=openai; name=OpenAI; url=https://api.openai.com/v1; var=OPENAI_API_KEY; def=gpt-4o-mini; link=https://platform.openai.com/api-keys ;;
    2) id=anthropic; name="Anthropic (Claude)"; url=https://api.anthropic.com/v1; var=ANTHROPIC_API_KEY; def=claude-sonnet-4-5; link=https://console.anthropic.com/settings/keys ;;
    3) id=deepseek; name=DeepSeek; url=https://api.deepseek.com/v1; var=DEEPSEEK_API_KEY; def=deepseek-chat; link=https://platform.deepseek.com/api_keys ;;
    4) id=openrouter-paid; name="OpenRouter (paid models)"; url=https://openrouter.ai/api/v1; var=OPENROUTER_API_KEY; def=openai/gpt-4o-mini; link=https://openrouter.ai/keys ;;
    5)
      id=ollama-local; name="Ollama (this computer)"; url=http://host.docker.internal:11434/v1; paid=false
      def="$(curl -s -m 3 http://127.0.0.1:11434/api/tags 2>/dev/null | grep -o '"name":"[^"]*"' | head -1 | cut -d'"' -f4 || true)"
      def="${def:-qwen3-coder}"
      ;;
    6)
      read -rp "  Address of the service (like https://api.example.com/v1): " url || exit 1
      url="${url%/}"; url="${url%/chat/completions}"; url="${url%/}"
      if [[ ! "$url" =~ ^https?://[^[:space:]\"\\\$]+$ ]]; then echo "That doesn't look like a web address. Nothing saved." >&2; exit 1; fi
      guess="${url#*://}"; guess="${guess%%/*}"; guess="${guess%%:*}"; guess="${guess#api.}"; guess="${guess%%.*}"
      guess="$(tr 'A-Z' 'a-z' <<<"$guess" | tr -c 'a-z0-9\n-' '-' | cut -c1-32)"
      read -rp "  A short name for it [$guess]: " id || exit 1
      id="$(tr 'A-Z ' 'a-z-' <<<"${id:-$guess}")"
      name="$id"
      var="CUSTOM_$(tr 'a-z-' 'A-Z_' <<<"$id")_API_KEY"
      ;;
    *) echo "Pick a number from 1 to 6. Nothing saved." >&2; exit 1 ;;
  esac
  reserved="$(grep -oE '^      "name": "[^"]+"' "$HERE/router/providers.json" 2>/dev/null | cut -d'"' -f4 || true)"
  if [[ ! "$id" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || grep -qxF "$id" <<<"$reserved"; then
    echo "\"$id\" can't be used as a name (use lowercase letters, numbers and dashes; not a built-in name). Nothing saved." >&2
    exit 1
  fi
  key=""
  if [[ -n "$var" ]]; then
    current="$(key_value "$var")"
    echo
    [[ -z "$link" ]] || echo "  Get a key: $link"
    if [[ -n "$current" ]]; then read -rsp "  Paste your $name key (Enter keeps the saved one): " key || exit 1
    else read -rsp "  Paste your $name key (hidden): " key || exit 1; fi
    echo
    key="${key:-$current}"
    if [[ -z "$key" || "$key" =~ [[:space:]] ]]; then echo "No usable key entered. Nothing saved." >&2; exit 1; fi
  fi
  if [[ -n "$def" ]]; then read -rp "  Model name(s), separated by spaces [$def]: " models || exit 1
  else read -rp "  Model name(s), separated by spaces: " models || exit 1; fi
  models="${models:-$def}"; models="${models//,/ }"
  [[ -n "${models// /}" ]] || { echo "Add at least one model name. Nothing saved." >&2; exit 1; }
  list=""
  for m in $models; do
    [[ "$m" =~ ^[A-Za-z0-9._:/@+-]+$ ]] || { echo "\"$m\" has characters Prism can't use. Nothing saved." >&2; exit 1; }
    list+="${list:+,}\"$m\""
  done
  first="${models%% *}"

  # What Prism's router (inside Docker) calls, and what this terminal can call.
  saved_url="$url"; test_url="$url"
  if [[ "$choice" == 6 && "$url" =~ ^https?://(localhost|127\.0\.0\.1)([:/]|$) ]]; then
    saved_url="$(sed -E 's#^(https?://)(localhost|127\.0\.0\.1)#\1host.docker.internal#' <<<"$url")"
    echo "  (the router runs in Docker, so it will reach this computer as host.docker.internal)"
  fi
  test_url="${test_url/host.docker.internal/127.0.0.1}"

  echo
  echo "Trying one tiny request to $first ..."
  body="$(mktemp)"
  code="$({ if [[ -n "$key" ]]; then printf 'authorization: Bearer %s\n' "$key"; fi; } | curl -sS -m 60 -o "$body" -w '%{http_code}' -H @- -H 'content-type: application/json' \
    -d "{\"model\":\"$first\",\"messages\":[{\"role\":\"user\",\"content\":\"Say hi\"}],\"max_tokens\":5}" "$test_url/chat/completions" 2>"$body.err")" || code=000
  if [[ "$code" == 2* ]]; then
    echo "It works."
  else
    case "$code" in
      000) echo "Couldn't reach $test_url: $(head -c 200 "$body.err")" ;;
      401|403) echo "The service didn't accept that key (HTTP $code). Check the key and that it has credit." ;;
      404) echo "The service doesn't know that address or model (HTTP 404): $(head -c 200 "$body")" ;;
      *) echo "The service answered HTTP $code: $(head -c 200 "$body")" ;;
    esac
    rm -f "$body" "$body.err"
    read -rp "Save it anyway? [y/N] " answer || answer=n
    [[ "$answer" == [yY]* ]] || { echo "Nothing saved."; exit 1; }
  fi
  rm -f "$body" "$body.err"

  if [[ -n "$var" ]]; then entry="\"keyVar\":\"$var\""; else entry="\"keyless\":true"; fi
  entry="{\"id\":\"$id\",\"name\":\"$name\",\"baseURL\":\"$saved_url\",$entry,\"models\":[$list],\"paid\":$paid}"
  { custom_lines | grep -vF "\"id\":\"$id\"" || true; echo "$entry"; } | save_custom_lines
  [[ -z "$var" ]] || set_key "$var" "$key"
  restart_router
  echo
  echo "Saved. Pick it by name: ${id}/${first}"
  if [[ "$paid" == false ]]; then echo "It's free to you, so \"auto\" can use it too."; else echo "Prism won't use it for \"auto\", so nothing is spent unless you pick it."; fi
}

keys_remove() {
  local id="${1:-}" line var pair free_var used=0
  [[ -n "$id" ]] || { echo "Which one? See the names with: $(prism_cmd) keys   then: $(prism_cmd) keys remove <id>" >&2; exit 1; }
  line="$(custom_lines | grep -F "\"id\":\"$id\"" || true)"
  [[ -n "$line" ]] || { echo "No model of yours is called \"$id\". See them with: $(prism_cmd) keys" >&2; exit 1; }
  var="$(entry_field keyVar "$line")"
  { custom_lines | grep -vF "\"id\":\"$id\"" || true; } | save_custom_lines
  if [[ -n "$var" ]]; then
    for pair in $FREE_KEYS; do [[ "${pair%%:*}" == "$var" ]] && used=1; done
    custom_lines | grep -qF "\"keyVar\":\"$var\"" && used=1
    if (( ! used )); then
      { grep -vE "^$var=" "$KEYS" 2>/dev/null || true; } > "$KEYS.tmp"
      mv "$KEYS.tmp" "$KEYS"
      chmod 600 "$KEYS"
    fi
  fi
  restart_router
  echo "Removed $id."
}

keys_cmd() {
  [[ -f "$KEYS" ]] || cp "$HERE/keys.example.conf" "$KEYS"
  chmod 600 "$KEYS"
  case "${1:-}" in
    "") keys_list ;;
    add) keys_add ;;
    remove|rm) keys_remove "${2:-}" ;;
    *) echo "Use: $(prism_cmd) keys | keys add | keys remove <id>" >&2; exit 1 ;;
  esac
}

# tree_cmd is `prism tree [text] [--html [file]] [--watch] [--json]` for the current folder.
tree_cmd() {
  local folder
  folder="$(pick_folder "")"
  if ! images_current; then
    build_images >/dev/null && mark_built || { echo "Couldn't build Prism. Run: $(prism_cmd) update" >&2; exit 1; }
  fi
  PROJECT_DIR="$folder" HOST_UID="$(id -u)" HOST_GID="$(id -g)" compose run --rm --no-deps -T agent tree "$@" 2> >(grep -v 'level=warning' >&2) |
    sed "s#^\(wrote\|updated\) \([^/]\)#\1 $folder/\2#"
}

case "${1:-}" in
  -h|--help|help) usage ;;
  tree) shift; tree_cmd "$@" ;;
  setup) setup ;;
  keys) keys_cmd "${2:-}" "${3:-}" ;;
  status) start_router; compose exec -T router wget -qO- "$ROUTER/status?format=text" ;;
  logs) compose logs -f router ;;
  stop) compose down ;;
  install) install ;;
  update)
    git -C "$HERE" pull --ff-only || { echo "Couldn't update. If you changed files in $HERE, move that folder away and run the install command again." >&2; exit 1; }
    build_images && mark_built && compose up -d router >/dev/null 2>&1
    echo "Prism is up to date."
    ;;
  web) folder="$(pick_folder "${2:-}")" || exit 1; web "$folder" ;;
  fix) fix ;;
  continue) folder="$(pick_folder "${2:-}")" || exit 1; run_agent "$folder" -continue ;;
  *) folder="$(pick_folder "${1:-}")" || exit 1; run_agent "$folder" ;;
esac
